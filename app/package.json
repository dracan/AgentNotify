{
  "name": "agent-notify",
  "version": "1.0.0",
  "description": "Custom popup notifications for Claude Code hooks",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently \"vite --host\" \"wait-on tcp:5174 && electron . --dev\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "pack": "pnpm run build && electron-builder --win nsis"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.agentnotify.app",
    "productName": "AgentNotify",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "assets/**/*", "package.json"],
    "icon": "assets/icon",
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
